rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to students collection
    match /students/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to quizResults collection
    match /quizResults/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to admin collection
    match /admin/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to test collection (for connection testing)
    match /test/{document} {
      allow read, write: if true;
    }
    
    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
