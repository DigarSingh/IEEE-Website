{
  "version": 2,
  "buildCommand": "npm run build:vercel --prefix ",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install && npm install --prefix ",
  "framework": "nextjs",
  "env": {
    "MONGODB_URI": "mongodb+srv://shivakoranga2004:wmH5pR0YIpTMYYh9@ieee.7fq9giv.mongodb.net/",
    "JWT_SECRET": "425db6441f3909d1fb283519392a14e5c69c7a11f397b4fb76cec5c6014033a1",
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/frontend/api/$1",
      "headers": {
        "cache-control": "s-maxage=0"
      }
    },
    {
      "src": "/(dashboard|admin|student)/(.*)",
      "dest": "/frontend/$1/$2",
      "headers": {
        "cache-control": "s-maxage=0, no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
